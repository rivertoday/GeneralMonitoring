    "fields": {
      "plan_id": 1,
      "node_code": "CH01",
      "node_name": "总则",
      "parent_id": 0,
      "node_type": 1,
      "node_level": 1,
      "node_content": "1.1 编制目的\n为了规范危险化学品事故应急处置工作，提高应急处置能力，最大限度减少人员伤亡和财产损失，保护生态环境，制定本预案。\n\n1.2 编制依据\n《中华人民共和国突发事件应对法》、《危险化学品安全管理条例》等法律法规。\n\n1.3 适用范围\n本预案适用于马鞍山市行政区域内发生的危险化学品事故应急处置工作。",
      "node_index": 1,
      "is_key_info": 0,
      "description": "预案总则章节",
      "remark": null,
      "created_at": "2024-01-02T08:00:00Z",
      "updated_at": "2024-01-02T08:00:00Z",
      "deleted_at": null
    }
  },
  {
    "model": "plan.planstructure",
    "pk": 2,
    "fields": {
      "plan_id": 1,
      "node_code": "CH02",
      "node_name": "组织体系",
      "parent_id": 0,
      "node_type": 1,
      "node_level": 1,
      "node_content": "2.1 应急指挥机构\n成立市危险化学品事故应急指挥部，由市政府分管领导任总指挥。\n\n2.2 成员单位职责\n应急管理局：负责综合协调和现场指挥。\n生态环境局：负责环境监测和污染处置。\n消防救援支队：负责现场救援和火灾扑救。",
      "node_index": 2,
      "is_key_info": 1,
      "description": "组织体系章节",
      "remark": null,
      "created_at": "2024-01-02T08:00:00Z",
