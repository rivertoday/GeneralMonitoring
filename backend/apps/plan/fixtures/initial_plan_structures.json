      "deleted_at": null
    }
  },
  {
    "model": "plan.planstructure",
    "pk": 7,
    "fields": {
      "plan_id": 2,
      "node_code": "CH02",
      "node_name": "汛情监测与预警",
      "parent_id": 0,
      "node_type": 1,
      "node_level": 1,
      "node_content": "2.1 监测预报\n气象部门负责降雨量监测和预报，水文部门负责水位监测和预报。\n\n2.2 预警发布\n当水位超过警戒水位时，发布橙色Ⅱ级预警；当水位超过保证水位时，发布红色I级预警。",
      "node_index": 2,
      "is_key_info": 1,
      "description": "汛情监测与预警章节",
      "remark": null,
      "created_at": "2024-01-02T08:00:00Z",
      "updated_at": "2024-01-02T08:00:00Z",
      "deleted_at": null
    }
  },
  {
    "model": "plan.planstructure",
    "pk": 8,
    "fields": {
      "plan_id": 3,
      "node_code": "CH01",
      "node_name": "事故发现与报告",
      "parent_id": 0,
      "node_type": 1,
      "node_level": 1,
      "node_content": "1.1 事故发现\n生产操作人员发现危化品泄漏后，立即停止相关作业，关闭泄漏源附近的阀门和设备。\n\n1.2 事故报告\n立即向企业应急值班室报告，报告内容包括：泄漏位置、泄漏物质、泄漏量、影响范围等。应急值班室接到报告后，立即启动现场处置方案。",
      "node_index": 1,
      "is_key_info": 1,
      "description": "事故发现与报告章节",
      "remark": null,
      "created_at": "2024-01-09T08:00:00Z",
      "updated_at": "2024-01-09T08:00:00Z",
      "deleted_at": null
    }
  },
  {
    "model": "plan.planstructure",
    "pk": 9,
    "fields": {
      "plan_id": 3,
      "node_code": "CH02",
      "node_name": "现场处置措施",
      "parent_id": 0,
      "node_type": 1,
      "node_level": 1,
      "node_content": "2.1 人员疏散\n立即组织泄漏点周边100米范围内所有人员向上风向或侧风向疏散至安全区域。\n\n2.2 泄漏源控制\n采取关闭阀门、堵漏、倒罐等措施控制泄漏源，防止泄漏扩大。\n\n2.3 污染物处置\n对泄漏物进行围堵、收集、处理，防止污染扩散。使用吸附材料、中和剂等处置泄漏物。",
      "node_index": 2,
      "is_key_info": 1,
      "description": "现场处置措施章节",
      "remark": null,
      "created_at": "2024-01-09T08:00:00Z",
      "updated_at": "2024-01-09T08:00:00Z",
      "deleted_at": null
    }
  },
  {
    "model": "plan.planstructure",
    "pk": 10,
    "fields": {
      "plan_id": 3,
      "node_code": "CH03",
      "node_name": "环境监测与安全防护",
      "parent_id": 0,
      "node_type": 1,
      "node_level": 1,
      "node_content": "3.1 环境监测\n对泄漏点周边空气、水体、土壤进行监测，评估污染程度和影响范围。\n\n3.2 安全防护\n处置人员必须佩戴防毒面具、防护服等个人防护装备，确保人身安全。",
      "node_index": 3,
      "is_key_info": 1,
      "description": "环境监测与安全防护章节",
      "remark": null,
      "created_at": "2024-01-09T08:00:00Z",
