# Django 生产环境配置示例
# 复制此文件为 .env.prod 并修改相应的配置值

# ============================================
# Django 核心配置
# ============================================
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=192.168.11.162,localhost,127.0.0.1

# ============================================
# 数据库配置
# ============================================
# 连接到 MySQL Docker 容器（端口 3308）
DB_NAME=risk_monitoring
DB_USER=root
DB_PASSWORD=YourPass123!
DB_HOST=127.0.0.1
DB_PORT=3308

# ============================================
# Gunicorn 配置
# ============================================
GUNICORN_WORKERS=4
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_TIMEOUT=120

# ============================================
# CORS 跨域配置
# ============================================
# 允许的前端来源，多个来源用逗号分隔，不要有空格
# 生产环境必须配置，否则前端无法访问后端 API
CORS_ALLOWED_ORIGINS=http://192.168.11.162:5173,http://192.168.11.162:5174

# ============================================
# CSRF 信任的来源
# ============================================
# 多个来源用逗号分隔，不要有空格
# 通常与 CORS_ALLOWED_ORIGINS 相同，再加上后端服务地址
CSRF_TRUSTED_ORIGINS=http://192.168.11.162:8888,http://192.168.11.162:5173,http://192.168.11.162:5174

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO

# ============================================
# 可选配置
# ============================================
# Gunicorn 日志目录（可选，默认使用项目目录下的 backend/logs）
# GUNICORN_LOG_DIR=/data/django/logs
